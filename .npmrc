# Use public npm registry by default. Private packages under the @senseaition scope
# are resolved from the Nexus registry. Do NOT store long-lived tokens in this file.
@senseaition:registry=https://nexus.senseaition.com/repository/npm/
//nexus.senseaition.com/repository/npm/:_authToken=${NPM_TOKEN}
//nexus.senseaition.rocks/repository/npm/:_authToken=${NPM_TOKEN}

# If you publish other private packages under different scopes, add similar lines:
# @other-scope:registry=https://nexus.senseaition.com/repository/npm/
# //nexus.senseaition.com/repository/npm/:_authToken=${NPM_TOKEN}
